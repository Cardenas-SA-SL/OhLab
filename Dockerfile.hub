FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig*.json ./
COPY src ./src
RUN npm run hub:build

FROM node:22-alpine
WORKDIR /app
ENV OHLAB_HUB_HOST=0.0.0.0 OHLAB_HUB_PORT=8791 OHLAB_HUB_DATA_DIR=/data
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /app/out/hub/main.cjs /app/out/hub/main.cjs
VOLUME ["/data"]
EXPOSE 8791
CMD ["node", "out/hub/main.cjs"]
